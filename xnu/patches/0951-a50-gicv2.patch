diff --git a/pexpert/pexpert/arm64/A50.h b/pexpert/pexpert/arm64/A50.h
new file mode 100644
index 0000000..abc3dae
--- /dev/null
+++ b/pexpert/pexpert/arm64/A50.h
@@ -0,0 +1,33 @@
+/*
+ * Board configuration for Samsung Galaxy A50 (SM-A505F, Exynos 9610).
+ * Reuse SWEET's open ARM64/XNU platform support, with A50's ARMv8-A cores
+ * and memory-mapped GICv2 CPU interface.
+ */
+#ifndef _PEXPERT_ARM64_A50_H
+#define _PEXPERT_ARM64_A50_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define A50_GIC_V2                1
+#define A50_VTIMER_INTID          27
+#define A50_IPI_SGI               1
+
+#undef HAS_GIC_V3
+#define HAS_GIC_V3              0
+/* Cortex-A53/A73 implement ARMv8-A; don't compile optional PAN/AES paths. */
+#undef __ARM_PAN_AVAILABLE__
+#undef __ARM_V8_CRYPTO_EXTENSIONS__
+
+#define A50_GICD_CTLR             0x000
+#define A50_GICD_IGROUPR0         0x080
+#define A50_GICD_ISENABLER0       0x100
+#define A50_GICD_IPRIORITYR0      0x400
+#define A50_GICD_SGIR             0xF00
+
+#define A50_GICC_CTLR             0x000
+#define A50_GICC_PMR              0x004
