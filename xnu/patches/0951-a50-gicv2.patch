diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..c50c6e1 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -3,6 +3,7 @@
  */
 
 #include <stdint.h>
+#include <libkern/libkern.h>
 #include <libkern/section_keywords.h>
 #include <arm64/proc_reg.h>
 #include <kern/clock.h>
@@ -222,6 +223,113 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif defined(A50_GIC_V2)
+/*
+ * Exynos 9610 exposes a GICv2 distributor and a memory-mapped, banked CPU
+ * interface. /arm-io/gic/reg contains <GICD offset, size, GICC offset, size>
+ * relative to the SoC base, matching the compact ADT generated for A50.
+ */
+static vm_offset_t a50_gicd_base;
+static vm_offset_t a50_gicc_base;
+
+static uint32_t
+a50_gic_read32(vm_offset_t base, vm_offset_t offset)
+{
+	return *((volatile uint32_t *)(base + offset));
+}
+
+static void
+a50_gic_write32(vm_offset_t base, vm_offset_t offset, uint32_t value)
+{
+	*((volatile uint32_t *)(base + offset)) = value;
+}
+
+uint32_t
+pe_a50_gicv2_ack(void)
+{
+	if (!a50_gicc_base) {
+		panic("%s: GICv2 CPU interface is not mapped", __func__);
+	}
+	return a50_gic_read32(a50_gicc_base, A50_GICC_IAR);
+}
+
+void
+pe_a50_gicv2_eoi(uint32_t iar)
+{
+	a50_gic_write32(a50_gicc_base, A50_GICC_EOIR, iar);
+}
+
+void
+pe_a50_gicv2_send_sgi(uint32_t target_mpidr)
+{
+	uint64_t current_mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	uint32_t current = (uint32_t)current_mpidr & 0x00FFFFFFU;
+	const uint32_t same_group_mask = 0x00FFFF00U;
+	uint32_t sgi;
+
+	if (current == (target_mpidr & 0x00FFFFFFU)) {
+		/* GICv2 filter 2 targets the sending CPU itself. */
+		sgi = (2U << 24) | A50_IPI_SGI;
+	} else if ((current & same_group_mask) ==
+	    (target_mpidr & same_group_mask) && (target_mpidr & 0xFFU) < 8) {
+		/* The target list addresses CPUs in the sender's affinity group. */
+		sgi = (1U << (16 + (target_mpidr & 0x7U))) | A50_IPI_SGI;
+	} else {
+		/* GICv2 cannot target another affinity group directly; wake all peers. */
+		sgi = (1U << 24) | A50_IPI_SGI;
+	}
+	a50_gic_write32(a50_gicd_base, A50_GICD_SGIR, sgi);
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+}
+
+void
+pe_init_fiq(void)
+{
+	int error;
+	DTEntry entry;
+	uint64_t reg[4];
+
+	if (!a50_gicd_base || !a50_gicc_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find A50 GIC node in ADT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size = 0;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot read A50 GIC reg property", __func__);
+		}
+		if (prop_size < sizeof(reg)) {
+			panic("%s: invalid A50 GIC reg property (%u bytes)", __func__, prop_size);
+		}
+		memcpy(reg, prop, sizeof(reg));
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		a50_gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		a50_gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!a50_gicd_base || !a50_gicc_base) {
+			panic("%s: cannot map A50 GICD/GICC regions", __func__);
+		}
+	}
+
+	uint32_t irq_mask = (1U << A50_VTIMER_INTID) | (1U << A50_IPI_SGI);
+	a50_gic_write32(a50_gicd_base, A50_GICD_IGROUPR0,
+	    a50_gic_read32(a50_gicd_base, A50_GICD_IGROUPR0) | irq_mask);
+	volatile uint8_t *priority = (volatile uint8_t *)(a50_gicd_base + A50_GICD_IPRIORITYR0);
+	priority[A50_VTIMER_INTID] = 0xA0;
+	priority[A50_IPI_SGI] = 0xA0;
+	a50_gic_write32(a50_gicd_base, A50_GICD_ISENABLER0, irq_mask);
+
+	a50_gic_write32(a50_gicc_base, A50_GICC_PMR, 0xFF);
+	a50_gic_write32(a50_gicc_base, A50_GICC_BPR, 0);
+	a50_gic_write32(a50_gicd_base, A50_GICD_CTLR,
+	    a50_gic_read32(a50_gicd_base, A50_GICD_CTLR) | (1U << 1));
+	a50_gic_write32(a50_gicc_base, A50_GICC_CTLR,
+	    a50_gic_read32(a50_gicc_base, A50_GICC_CTLR) | (1U << 1));
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+}
 #else
 void
 pe_init_fiq()
